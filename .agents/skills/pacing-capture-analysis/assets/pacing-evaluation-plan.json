{
  "schema": "relimiter-pacing-evaluation/2",
  "question": "Does holding each frame to the cap cadence (the output hold) reduce display jitter compared with releasing the game on the cadence alone, and where does it stop helping?",
  "notes": [
    "Copy this file next to the archived captures, fill build, scenes and each run's capture path (relative to this file), then run compare_pacing.py on it.",
    "Choose thresholds before capturing; do not tune them after seeing results.",
    "Every arm is captured twice per scene; the spread between its two runs is that arm's A/A noise floor."
  ],
  "build": {
    "relimiter_build": null,
    "relimiter_artifact_sha256": null,
    "architecture": "x64",
    "gpu": null,
    "gpu_driver": null,
    "display": null,
    "refresh_hz": null,
    "vrr": null
  },
  "common_settings": {
    "config_version": "2",
    "developer_settings": "true",
    "native_pcl_enabled": "true",
    "adaptive_cap": "false",
    "gpu_present_gate_probes": "true",
    "gpu_wait_headroom_us": "1000",
    "marker_forward_order": "before_wait",
    "stall_inject_ms": "0",
    "reflex_sleep_bypass": "false",
    "log_level": "info"
  },
  "arms": {
    "A": {
      "label": "release only",
      "settings": {
        "smoothing": "off",
        "output_rung": "auto",
        "source_placement": "marker"
      },
      "osd": "Smoothing off, Output override Auto, Source placement Marker",
      "expect": {
        "reasons": [
          "smoothing_off"
        ],
        "rungs": [
          "source_only"
        ],
        "placement": "marker"
      }
    },
    "B": {
      "label": "hold, Auto (shipping)",
      "settings": {
        "smoothing": "on",
        "output_rung": "auto",
        "source_placement": "marker"
      },
      "osd": "Smoothing on, Output override Auto, Source placement Marker",
      "expect": {
        "reasons": [
          "none",
          "infeasible"
        ],
        "placement": "marker"
      }
    },
    "Bp": {
      "label": "hold without overload fallback or collision-aware release",
      "settings": {
        "smoothing": "on",
        "output_rung": "gpu",
        "source_placement": "marker"
      },
      "osd": "Smoothing on, Output override GPU wait, Source placement Marker",
      "expect": {
        "reasons": [
          "override"
        ],
        "rungs": [
          "gpu_queue_wait",
          "fg_input_wait"
        ],
        "placement": "marker"
      }
    },
    "C": {
      "label": "Reflex driver limiter",
      "settings": {
        "smoothing": "on",
        "output_rung": "auto",
        "source_placement": "driver"
      },
      "osd": "Smoothing on, Output override Auto, Source placement Reflex driver limiter",
      "expect": {
        "reasons": [
          "override"
        ],
        "placement": "driver_limiter"
      }
    }
  },
  "scenes": [
    {
      "id": "rogue_core_light",
      "class": "light",
      "application": "Rogue Core",
      "target_fps": 130,
      "frame_generation": "off",
      "description": "Light, steady scene at a 130 FPS cap without FG (the D2 archive conditions)."
    },
    {
      "id": "rogue_core_heavy",
      "class": "heavy",
      "application": "Rogue Core",
      "target_fps": 130,
