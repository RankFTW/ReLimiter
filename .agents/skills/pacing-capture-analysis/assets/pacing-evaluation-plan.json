{
  "schema": "relimiter-pacing-evaluation/2",
  "question": "Does the pacer beat the game's own Reflex alone and the Reflex driver limiter at the same cap, and what do its latency and smooth preferences trade against the balanced default?",
  "notes": [
    "Copy this file next to the archived captures, fill build, scenes and each run's capture path (relative to this file), then run compare_pacing.py on it.",
    "Choose thresholds before capturing; do not tune them after seeing results.",
    "Every arm is captured twice per scene; the spread between its two runs is that arm's A/A noise floor.",
    "Arms set only keys that exist in this build: pacing_test_mode (honoured with developer_settings), pacing_preference and the frame rate cap target_fps. A scene's cap (target_fps) is set in relimiter.ini before the session unless an arm sets its own (R0u: off).",
    "Reflex-only (R0, R0u) and the driver limiter (D) are test modes: reflex_only paces nothing, driver_limiter lets the Reflex driver pace at the cap's interval (a 64-bit DirectX 12 game that calls the Reflex Sleep). They are comparison instruments, never a pacing path of the product.",
    "R0u runs only where the scene has no cap to hold; its comparison with B states what the cap costs and gains."
  ],
  "build": {
    "relimiter_build": null,
    "relimiter_artifact_sha256": null,
    "architecture": "x64",
    "gpu": null,
    "gpu_driver": null,
    "display": null,
    "refresh_hz": null,
    "vrr": null
  },
  "common_settings": {
    "config_version": "6",
    "developer_settings": "true",
    "native_pcl_enabled": "true",
    "gpu_present_gate_probes": "true",
    "log_level": "info"
  },
  "arms": {
    "L": {
      "label": "pacer, latency preference",
      "settings": {
        "pacing_test_mode": "off",
        "pacing_preference": "latency"
      },
      "osd": "Pacing preference Latency",
      "expect": {
        "reasons": [
          "none",
          "idle_cap",
          "present_route",
          "fixed_refresh",
          "no_native_route",
          "no_gpu_queue",
          "fg_unqualified",
          "fg_route_unsupported",
          "architecture",
          "api"
        ]
      }
    },
    "B": {
      "label": "pacer, balanced preference (default)",
      "settings": {
        "pacing_test_mode": "off",
        "pacing_preference": "balanced"
      },
      "osd": "Pacing preference Balanced",
      "expect": {
        "reasons": [
          "none",
          "idle_cap",
          "present_route",
          "fixed_refresh",
          "no_native_route",
          "no_gpu_queue",
          "fg_unqualified",
          "fg_route_unsupported",
          "architecture",
          "api"
        ]
      }
    },
    "S": {
      "label": "pacer, smooth preference",
      "settings": {
        "pacing_test_mode": "off",
        "pacing_preference": "smooth"
      },
      "osd": "Pacing preference Smooth",
      "expect": {
        "reasons": [
          "none",
          "idle_cap",
          "present_route",
          "fixed_refresh",
          "no_native_route",
          "no_gpu_queue",
          "fg_unqualified",
          "fg_route_unsupported",
          "architecture",
          "api"
        ]
      }
    },
    "R0": {
      "label": "the game's own Reflex alone (test mode reflex_only)",
      "settings": {
        "pacing_test_mode": "reflex_only"
      },
      "osd": "Developer diagnostics: Pacing owner (test) Reflex only",
      "expect": {
        "reasons": [
          "passthrough"
        ],
        "placement": "none"
      }
    },
    "R0u": {
      "label": "the game's own Reflex alone, no cap (test mode reflex_only, target_fps 0)",
      "settings": {
        "pacing_test_mode": "reflex_only",
        "target_fps": "0"
      },
      "osd": "Developer diagnostics: Pacing owner (test) Reflex only; frame rate cap off",
      "expect": {
        "reasons": [
          "passthrough"
        ],
        "placement": "none"
      }
    },
    "D": {
      "label": "the Reflex driver limiter at the cap's interval (test mode driver_limiter)",
      "settings": {
        "pacing_test_mode": "driver_limiter"
      },
      "osd": "Developer diagnostics: Pacing owner (test) NVIDIA's limiter",
      "expect": {
        "reasons": [
          "override"
        ],
        "placement": "driver_limiter"
      }
    }
  },
  "scenes": [
    {
      "id": "rogue_core_light",
      "class": "light",
      "application": "Rogue Core",
      "target_fps": 130,
      "frame_generation": "off",
      "description": "Light, steady scene at a 130 FPS cap without FG."
    },
    {
      "id": "rogue_core_heavy",
      "class": "heavy",
      "application": "Rogue Core",
      "target_fps": 130,
      "frame_generation": "off",
      "description": "GPU-heavy area at the same cap."
    },
    {
      "id": "gears_eday_fg2x",
      "class": "heavy",
      "application": "Gears of War: E-Day",
      "target_fps": null,
      "frame_generation": "2x",
      "description": "Sustained heavy stretch with DLSS frame generation 2x."
    },
    {
      "id": "present_route_light",
      "class": "light",
      "application": "a process without the NvAPI Reflex marker route",
      "target_fps": 60,
      "frame_generation": "off",
      "description": "Light, steady scene in a game or process without the NvAPI Reflex markers (32-bit or non-DirectX 12): the present-only route paces, the driver limiter is unavailable."
    }
  ],
  "protocol": {
    "run_order": [
      "B",
      "R0",
      "D",
      "S",
      "L",
      "B",
      "R0",
      "D",
      "S",
      "L"
    ],
    "settle_seconds": 15,
    "capture_seconds": 180,
    "warmup_seconds": 5,
    "min_display_intervals": 10000
  },
  "analysis": {
    "block_seconds": 5.0,
    "bootstrap_iterations": 1000,
    "seed": 20261003,
    "confidence": 0.95,
    "deviation_thresholds_us": [
      1000,
      2000
    ],
    "min_effect": {
      "jitter_p50_us": 10,
      "jitter_p90_us": 25,
      "jitter_p99_us": 50,
      "dev_share_over_1000us": 0.002,
      "dev_share_over_2000us": 0.002,
      "long_frame_share": 0.001,
      "abs_animation_error_p99_us": 50,
      "pc_latency_p50_us": 250
    }
  },
  "comparisons": [
    {
      "id": "pacer_vs_reflex_only",
      "candidate": "B",
      "baseline": "R0",
      "question": "Does the balanced pacer beat the game's own Reflex alone at the same cap?"
    },
    {
      "id": "pacer_vs_driver_limiter",
      "candidate": "B",
      "baseline": "D",
      "question": "Does the balanced pacer beat NVIDIA's Reflex driver limiter at the same cap?"
    },
    {
      "id": "smooth_vs_balanced",
      "candidate": "S",
      "baseline": "B",
      "question": "Does the smooth preference even out the display beyond the balanced default, and what does it cost in latency?"
    },
    {
      "id": "latency_vs_balanced",
      "candidate": "L",
      "baseline": "B",
      "question": "Does the latency preference lower PC latency, and what does it cost in display jitter?"
    },
    {
      "id": "pacer_vs_reflex_only_uncapped",
      "candidate": "B",
      "baseline": "R0u",
      "question": "With frame generation, does the balanced pacer at the cap pace better than the game's own Reflex alone with no cap, and what does it cost in latency?"
    }
  ],
  "decision": {
    "primary_metrics": [
      "jitter_p99_us",
      "dev_share_over_2000us"
    ],
    "latency_metric": "pc_latency_p50_us",
    "judge": [
      {
        "id": "pacer_default",
        "comparison": "pacer_vs_reflex_only",
        "label": "pacer against Reflex alone"
      }
    ]
  },
