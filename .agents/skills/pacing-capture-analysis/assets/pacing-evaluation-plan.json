      "class": "heavy",
      "application": "Gears of War: E-Day",
      "target_fps": null,
      "frame_generation": "2x",
      "description": "Sustained heavy stretch with DLSS frame generation 2x."
    }
  ],
  "protocol": {
    "run_order": [
      "A",
      "B",
      "Bp",
      "C",
      "A",
      "B",
      "Bp",
      "C"
    ],
    "settle_seconds": 15,
    "capture_seconds": 180,
    "warmup_seconds": 5,
    "min_display_intervals": 10000
  },
  "analysis": {
    "block_seconds": 5.0,
    "bootstrap_iterations": 1000,
    "seed": 20261003,
    "confidence": 0.95,
    "deviation_thresholds_us": [
      1000,
      2000
    ],
    "min_effect": {
      "jitter_p50_us": 10,
      "jitter_p90_us": 25,
      "jitter_p99_us": 50,
      "dev_share_over_1000us": 0.002,
      "dev_share_over_2000us": 0.002,
      "long_frame_share": 0.001,
      "abs_animation_error_p99_us": 50,
      "pc_latency_p50_us": 250
    }
  },
  "comparisons": [
    {
      "id": "hold_vs_release",
      "candidate": "B",
      "baseline": "A",
      "question": "Does the shipping hold (Auto, with its overload fallback and collision-aware release) beat releasing on the cadence alone?"
    },
    {
      "id": "raw_hold_vs_release",
      "candidate": "Bp",
      "baseline": "A",
      "question": "Does the hold without its overload fallback and collision-aware release beat releasing on the cadence alone?"
    },
    {
      "id": "fallback_vs_raw_hold",
      "candidate": "B",
      "baseline": "Bp",
      "question": "Do the overload fallback and the collision-aware release improve on the hold without them?"
    },
    {
      "id": "release_vs_driver_limiter",
      "candidate": "A",
      "baseline": "C",
      "question": "Is ReLimiter's release cadence better than NVIDIA's Reflex driver limiter?"
    }
  ],
  "decision": {
    "primary_metrics": [
      "jitter_p99_us",
      "dev_share_over_2000us"
    ],
    "latency_metric": "pc_latency_p50_us",
    "latency_budget_us": 2000,
    "judge": [
      {
        "id": "hold_default",
        "comparison": "hold_vs_release",
        "label": "hold as default output"
      }
    ],
    "fallback": {
      "comparison": "raw_hold_vs_release",
      "judged": "hold_default"
    }
  },
