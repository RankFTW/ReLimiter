#include <winresrc.h>
#include "relimiter_version.h"

#define VER_MAJOR RELIMITER_VERSION_MAJOR
#define VER_MINOR RELIMITER_VERSION_MINOR
#define VER_PATCH RELIMITER_VERSION_PATCH
#define VER_BUILD 0

#define VER_STR RELIMITER_VERSION_STRING_RC
#define VER_PRODUCT "ReLimiter"
#define VER_DESCRIPTION "G-Sync/VRR Frame Pacing Addon for ReShade"
#define VER_COPYRIGHT "RankFTW, Lazorr, UltraMatt"
#ifdef _WIN64
#define VER_FILENAME "relimiter.addon64"
#else
#define VER_FILENAME "relimiter.addon32"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION    VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      VER_COPYRIGHT
            VALUE "FileDescription",  VER_DESCRIPTION
            VALUE "FileVersion",      VER_STR
            VALUE "InternalName",     "relimiter"
            VALUE "LegalCopyright",   VER_COPYRIGHT
            VALUE "OriginalFilename", VER_FILENAME
            VALUE "ProductName",      VER_PRODUCT
            VALUE "ProductVersion",   VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
